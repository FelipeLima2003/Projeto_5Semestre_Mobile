<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/scroll_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/backgroud_scrollview">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- CABEÇALHO -->
            <LinearLayout
                android:id="@+id/header_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#212121"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="15dp"
                android:paddingVertical="11dp">

                <ImageView
                    android:id="@+id/img_back_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="13dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/seta_voltar"
                    android:contentDescription="@string/voltar" />

                <TextView
                    android:id="@+id/text_voltar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voltar"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/options_menu_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@android:drawable/ic_menu_more"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:contentDescription="Opções"/>
            </LinearLayout>

            <!-- ÁREA PARTICIPANTES -->
            <LinearLayout
                android:id="@+id/container_participantes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:background="#A5CCFF"
                android:orientation="vertical"
                android:paddingTop="9dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/txt_participantes_titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="26dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/busca_participantes_titulo"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Imagens ilustrativas (mantendo as suas) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <!-- Troque pelos seus drawables reais se tiver -->
                    <ImageView android:layout_width="50dp" android:layout_height="50dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_launcher_background" />
                    <ImageView android:layout_width="50dp" android:layout_height="50dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_launcher_background" />
                    <ImageView android:layout_width="50dp" android:layout_height="50dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_launcher_background" />
                    <ImageView android:layout_width="50dp" android:layout_height="50dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_launcher_background" />
                    <ImageView android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/ic_launcher_background" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txt_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="27dp"
                android:layout_marginBottom="22dp"
                android:text="@string/busca_eventos_titulo"
                android:textColor="#1A1A1C"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- === CARD EVENTO 1 === -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_evento_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="#3DA3FF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Maratona do Rio"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15 de Dezembro • 12km"
                            android:textSize="14sp"
                            android:textColor="#757575"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Venha participar da maior corrida de rua da cidade. Percurso plano e vista para o mar."
                            android:textSize="14sp"
                            android:textColor="#616161"
                            android:layout_marginBottom="20dp"/>

                        <!-- ÁREA DO BOTÃO E CHECKBOX (MODIFICADA) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <Button
                                android:id="@+id/btn_inscrever_evento1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/btn_inscrever"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:backgroundTint="#212121"
                                app:cornerRadius="8dp"/>

                            <!-- CheckBox inicialmente invisível -->
                            <CheckBox
                                android:id="@+id/check_inscrito_evento1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:checked="true"
                                android:clickable="false"
                                android:visibility="gone"
                                android:buttonTint="#4CAF50"
                                android:text="Inscrito"
                                android:textColor="#4CAF50"
                                android:textStyle="bold"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- === CARD EVENTO 2 === -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_evento_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="#FF9800" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Corrida Noturna SP"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20 de Dezembro • 5km"
                            android:textSize="14sp"
                            android:textColor="#757575"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Desafie seus limites sob as luzes da cidade. Uma experiência única de corrida noturna."
                            android:textSize="14sp"
                            android:textColor="#616161"
                            android:layout_marginBottom="20dp"/>

                        <!-- ÁREA DO BOTÃO E CHECKBOX (MODIFICADA) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <Button
                                android:id="@+id/btn_inscrever_evento2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/btn_inscrever"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:backgroundTint="#212121"
                                app:cornerRadius="8dp"/>

                            <CheckBox
                                android:id="@+id/check_inscrito_evento2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:checked="true"
                                android:clickable="false"
                                android:visibility="gone"
                                android:buttonTint="#4CAF50"
                                android:text="Inscrito"
                                android:textColor="#4CAF50"
                                android:textStyle="bold"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BOTÃO FLUTUANTE -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_iniciar_corrida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_margin="20dp"
                android:backgroundTint="#212121"
                android:src="@android:drawable/ic_media_play"
                app:tint="#FFFFFF"
                android:contentDescription="@string/desc_fab_iniciar_corrida"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>

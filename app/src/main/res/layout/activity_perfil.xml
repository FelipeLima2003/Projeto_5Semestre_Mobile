<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context=".PerfilActivity">

    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#212121"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="15dp"
        android:paddingVertical="11dp">

        <ImageView
            android:id="@+id/icon_voltar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="13dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/seta_voltar"
            android:contentDescription="@string/voltar" />

        <TextView
            android:id="@+id/text_voltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/voltar"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp">

                <!-- A Foto de Perfil -->
                <androidx.cardview.widget.CardView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/img_perfil_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/logo"
                        android:contentDescription="@string/cadastro_desc_foto" />
                </androidx.cardview.widget.CardView>

                <!-- Ícone de Editar (Câmera) -->
                <ImageView
                    android:id="@+id/btn_editar_foto"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/circle_background_blue"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#FFFFFF"
                    android:visibility="gone"
                    tools:visibility="visible"/>
                <!-- A visibility começa gone e só aparece se for o MEU perfil -->
            </FrameLayout>

            <TextView
                android:id="@+id/txt_perfil_nome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="4dp"
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Nome do Usuário" />

            <TextView
                android:id="@+id/txt_perfil_genero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:textSize="16sp"
                tools:text="@string/genero_masculino"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/perfil_sobre_mim"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edit_perfil_descricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/stroke_black"
                android:gravity="top"
                android:hint="@string/perfil_hint_descricao"
                android:inputType="textMultiLine"
                android:minHeight="120dp"
                android:padding="12dp"
                android:textSize="16sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/txt_perfil_descricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:visibility="gone"
                tools:text="Esta é a minha biografia."
                tools:visibility="gone" />

            <Button
                android:id="@+id/btn_salvar_perfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/black"
                android:text="@string/perfil_btn_salvar"
                android:textColor="@android:color/white"
                android:visibility="gone"
                tools:visibility="visible"/>

            <Button
                android:id="@+id/btn_excluir_perfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:backgroundTint="#FF4444"
                android:text="@string/perfil_btn_excluir"
                android:textColor="@android:color/white"
                android:visibility="gone"
                tools:visibility="visible"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_proximo_evento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="24dp"
                android:layout_gravity="center_horizontal"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#F0F8FF"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perfil_proximo_evento_label"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#3DA3FF"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/txt_evento_nome_perfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Nome do Evento"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1C"/>

                    <TextView
                        android:id="@+id/txt_evento_detalhes_perfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data • Distância"
                        android:textSize="14sp"
                        android:textColor="#757575"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_historico_titulo"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_corridas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_corrida" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
